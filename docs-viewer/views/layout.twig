<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title|default('Axis Twelve') }}</title>
    <link rel="stylesheet" href="/dist/axis-twelve.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --bg: #f8fafc;
            --text: #1e293b;
            --sidebar-bg: #ffffff;
            --nav-bg: #ffffff;
            --shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
        body {
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            scroll-behavior: smooth;
        }
        .navbar {
            background: var(--nav-bg);
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary);
            text-decoration: none;
            letter-spacing: -0.025em;
        }
        .navbar-menu {
            display: flex;
            gap: 2rem;
        }
        .navbar-menu a {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            transition: color 0.2s;
        }
        .navbar-menu a:hover, .navbar-menu a.active {
            color: var(--primary);
        }
        .main-content {
            flex: 1;
            display: flex;
        }
        .sidebar {
            width: 280px;
            background: white;
            border-right: 1px solid #e2e8f0;
            padding: 2rem;
            height: calc(100vh - 65px);
            position: sticky;
            top: 65px;
            overflow-y: auto;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .sidebar-menu li {
            margin-bottom: 0.5rem;
        }
        .sidebar-menu a {
            display: block;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            text-decoration: none;
            color: #64748b;
            transition: all 0.2s;
        }
        .sidebar-menu a:hover {
            background: #f1f5f9;
            color: var(--text);
        }
        .sidebar-menu a.active {
            background: #eff6ff;
            color: var(--primary);
            font-weight: 600;
        }
        .content-area {
            flex: 1;
            padding: 3rem;
            max-width: 1000px;
            margin: 0 auto;
        }
        .card {
            background: white;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        @media (max-width: 768px) {
            .main-content {
                flex-direction: column;
            }
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
                top: 0;
                border-right: none;
                border-bottom: 1px solid #e2e8f0;
                padding: 1rem;
            }
            .sidebar-menu {
                display: flex;
                overflow-x: auto;
                gap: 1rem;
            }
            .sidebar-menu li {
                margin-bottom: 0;
                white-space: nowrap;
            }
            .content-area {
                padding: 1.5rem;
            }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">Axis Twelve</a>
        <div class="navbar-menu">
            <a href="/" class="{% if current_page == 'home' %}active{% endif %}">Home</a>
            <a href="/docs" class="{% if current_page == 'docs' %}active{% endif %}">Documentation</a>
            <a href="/examples" class="{% if current_page == 'examples' %}active{% endif %}">Examples</a>
            <a href="/changelogs" class="{% if current_page == 'changelogs' %}active{% endif %}">Changelogs</a>
        </div>
    </nav>

    <main class="main-content">
        {% block main %}{% endblock %}
    </main>

    {% block footer %}{% endblock %}
</body>
</html>
