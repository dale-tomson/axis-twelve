{% extends 'layout.twig' %}

{% set current_page = 'home' %}

{% block main %}
<div class="content-area">
    <section class="hero card" style="text-align: center; padding: 4rem 2rem;">
        <h1 style="font-size: 3rem; margin-bottom: 1rem; color: var(--primary);">Axis Twelve</h1>
        <p style="font-size: 1.25rem; color: #64748b; margin-bottom: 2rem;">A lightweight, modular, and modern CSS framework for building beautiful web interfaces with ease.</p>
        
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/docs" class="ax-btn ax-btn--primary">Get Started</a>
            <a href="https://github.com/dale-tomson/axis-twelve" class="ax-btn ax-btn--secondary" target="_blank">GitHub</a>
        </div>

        <div style="margin-top: 2rem; font-weight: 500;">
            Current Version: <span class="ax-badge ax-badge--primary">{{ version }}</span>
        </div>
    </section>

    <section class="card">
        <h2>Module Sizes</h2>
        <p>Axis Twelve is built with modularity in mind. Only include what you need.</p>
        <table class="ax-table" style="width: 100%;">
            <thead>
                <tr>
                    <th>Module</th>
                    <th>File</th>
                    <th>Size (Minified)</th>
                </tr>
            </thead>
            <tbody>
                {% for module in modules %}
                <tr>
                    <td>{{ module.name }}</td>
                    <td><code>{{ module.file }}</code></td>
                    <td><strong>{{ module.size }}</strong></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="card">
        <h2>Usage</h2>
        <div style="margin-bottom: 2rem;">
            <h3>NPM</h3>
            <pre style="background: #f1f5f9; padding: 1rem; border-radius: 0.5rem; overflow-x: auto;"><code>npm install axis-twelve</code></pre>
        </div>
        <div>
            <h3>CDN</h3>
            <pre style="background: #f1f5f9; padding: 1rem; border-radius: 0.5rem; overflow-x: auto;"><code>&lt;link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/axis-twelve@{{ version }}/dist/axis-twelve.min.css"&gt;</code></pre>
        </div>
    </section>

    <section style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <div class="card" style="text-align: center;">
            <h3>Documentation</h3>
            <p>Learn how to use Axis Twelve components and layout system.</p>
            <a href="/docs" class="ax-btn ax-btn--outline">View Docs</a>
        </div>
        <div class="card" style="text-align: center;">
            <h3>Examples</h3>
            <p>See Axis Twelve in action with real-world examples.</p>
            <a href="/examples" class="ax-btn ax-btn--outline">View Examples</a>
        </div>
    </section>
</div>
{% endblock %}
